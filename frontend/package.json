{
  "name": "field-under-pressure-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/main.ts --bundle --format=esm --sourcemap --target=es2020 --loader:.png=file --loader:.svg=file --outdir=static/frontend/dist",
    "watch": "npm run bundle -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.20",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "leaflet": "^1.9.4",
    "marked": "^15.0.12"
  }
}
