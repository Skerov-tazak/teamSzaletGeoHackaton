{
  "name": "field-under-pressure-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "bundle": "esbuild src/main.ts --bundle --format=esm --sourcemap --target=es2020 --outdir=static/frontend/dist",
    "watch": "npm run bundle -- --watch",
    "typecheck": "tsc --noEmit",
    "map:dev": "esbuild src/map/dev/harness.ts --bundle --format=esm --sourcemap --target=es2020 --loader:.png=file --outdir=static/frontend/dist/map-dev",
    "map:watch": "npm run map:dev -- --watch"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
